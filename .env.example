OPENAI_API_KEY=
# Optional explicit routing for trace export. Set these to the project and
# organization selected in the OpenAI Platform when one account has several.
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=
MASSIVE_API_KEY=
TAVILY_API_KEY=

# standard runs the configured API/scheduler. demo is seeded, simulated,
# credential-free, and rejects all HTTP mutations.
APP_MODE=standard
# Use with APP_MODE=standard and API_ACCESS_MODE=public for a recruiter-facing
# dashboard. HTTP is read-only while the private scheduler keeps running real AI.
PUBLIC_SHOWCASE=false

# Market data: simulated works without credentials; end_of_day requires Massive.
# Delayed and real-time modes intentionally fail startup in Phase 1.
MARKET_DATA_MODE=simulated
MARKET_DATA_FALLBACK=fail_closed
# Defaults: 300 for simulated and 345600 (4 days) for end_of_day.
# MARKET_DATA_FRESHNESS_SECONDS=300
MARKET_DATA_TIMEOUT_SECONDS=10
# Retries only timeouts, HTTP 429, and HTTP 5xx responses.
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_RETRY_BACKOFF_SECONDS=0.5
# Reuse successful EOD observations for one hour; set to 0 to disable.
MARKET_DATA_CACHE_SECONDS=3600

# Optional notification integration
PUSHOVER_USER=
PUSHOVER_TOKEN=

# Runtime settings
# daily_utc waits until the configured post-close time before its first cycle.
SCHEDULER_MODE=daily_utc
SCHEDULER_DAILY_TIME_UTC=22:30
# Used only when SCHEDULER_MODE=interval.
RUN_EVERY_N_MINUTES=1440
AGENT_MAX_CONCURRENCY=1
RUN_EVEN_WHEN_MARKET_IS_CLOSED=false
SHUTDOWN_GRACE_SECONDS=30
# Used for all four traders when USE_MANY_MODELS=false.
MODEL_NAME=gpt-5.4-mini
# Pinned non-reasoning model used only for bounded research synthesis.
RESEARCH_MODEL_NAME=gpt-4.1-mini-2025-04-14
USE_MANY_MODELS=false

# MCP resilience (all waits and retries are bounded)
MCP_STARTUP_TIMEOUT_SECONDS=20
MCP_REQUEST_TIMEOUT_SECONDS=30
MCP_MAX_RETRIES=2
MCP_RETRY_BACKOFF_SECONDS=0.5
MCP_CIRCUIT_FAILURE_THRESHOLD=3
MCP_CIRCUIT_RESET_SECONDS=60

# Per-trader cycle budgets. Set cost rates to the highest selected model rate so
# mixed research/trader estimates remain conservative. Zero rates keep spend
# estimates explicit at $0 rather than guessing prices.
CYCLE_MAX_TURNS=8
CYCLE_MAX_TOKENS=40000
CYCLE_MAX_WALL_SECONDS=180
CYCLE_MAX_SPEND_USD=5
MODEL_MAX_RETRIES=4
MODEL_INPUT_COST_PER_MILLION=0.75
MODEL_OUTPUT_COST_PER_MILLION=4.50
RESEARCH_MODEL_INPUT_COST_PER_MILLION=0.40
RESEARCH_MODEL_OUTPUT_COST_PER_MILLION=1.60

# The API is local-only by default. Public mode requires a random token of at
# least 32 characters and a TLS reverse proxy; write requests use Bearer auth.
API_ACCESS_MODE=local
API_AUTH_TOKEN=
API_RATE_LIMIT_REQUESTS=60
API_RATE_LIMIT_WINDOW_SECONDS=60

# Optional SQLite path; databases are runtime artifacts and must not be committed.
ACCOUNTS_DB=accounts.db

# Optional model providers used only when USE_MANY_MODELS=true
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROK_API_KEY=
